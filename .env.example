# Strapi internal URL — set to your Strapi Coolify service URL (no public domain needed)
# On the same Coolify server, use the internal hostname Coolify assigns, e.g.:
# NEXT_STRAPI_BASE_URL=http://<strapi-service-uuid>:1337
NEXT_STRAPI_BASE_URL=
NEXT_STRAPI_API_KEY=

# AGMARKNET market rates (https://data.gov.in)
DATA_GOV_IN_API_KEY=

# Weather API (optional)
WEATHER_API_KEY=

# Instagram feed (optional — cookies expire periodically)
INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=
INSTAGRAM_IG_DID=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_MID=
INSTAGRAM_DATR=

# Careers form email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CAREER_EMAIL_TO=info@greengoldseeds.co.in
